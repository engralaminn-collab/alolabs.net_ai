{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:generate:mysql": "prisma generate --schema=prisma/schema.mysql.prisma",
    "db:push:mysql": "prisma db push --schema=prisma/schema.mysql.prisma",
    "db:generate:schema": "npx tsx scripts/generate-mysql-schema.ts",
    "db:migrate:mysql": "npx tsx scripts/migrate-sqlite-to-mysql.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "seed:enterprise": "npx tsx scripts/seed-enterprise-v3.ts"
  },
  "dependencies": {
