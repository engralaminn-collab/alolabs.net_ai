{
  "name": "alolabs-agentos",
  "version": "1.0.0",
  "description": "ALO Labs AgentOS / AI-EOS — Enterprise Artificial Intelligence Operating System",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3011 2>&1 | tee dev.log",
    "build": "NODE_OPTIONS=--max-old-space-size=3072 next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "PORT=3011 NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "start:bun": "PORT=3011 NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "node --max-old-space-size=3072 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:generate:mysql": "prisma generate --schema=prisma/schema.mysql.prisma",
    "db:push:mysql": "prisma db push --schema=prisma/schema.mysql.prisma",
    "db:generate:schema": "npx tsx scripts/generate-mysql-schema.ts",
    "db:migrate:mysql": "npx tsx scripts/migrate-sqlite-to-mysql.ts",
    "db:migrate": "prisma migrate dev",
    "verify:workforce": "npx tsx scripts/verify-2000-workforce.ts",
    "verify:mysql": "npx tsx scripts/verify-mysql-compatibility.ts",
    "seed:enterprise": "npx tsx scripts/seed-enterprise-v3.ts",
    "seed:departments": "npx tsx scripts/seed-100-departments.ts",
    "check:prisma-delegates": "tsx scripts/check-prisma-delegates.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.16",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.525.0",
    "minio": "^8.0.7",
    "mysql2": "^3.24.4",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "6.19.2",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^6.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.4"
}
