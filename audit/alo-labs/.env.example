# ==============================================================================
# ALO Labs AgentOS V3 Environment Variables (Template)
# ==============================================================================

APP_NAME="ALO Labs Command Center"
APP_ENV=production
APP_DEBUG=false

# Domain Settings
MAIN_DOMAIN=alolabs.net
PUBLIC_URL=http://103.239.252.41
COMMAND_CENTER_URL=http://103.239.252.41
API_URL=http://103.239.252.41/api
SERVER_IP=103.239.252.41
API_PORT=8080

# Security and Credentials
SUPER_ADMIN_EMAIL=ceo.alo.alaminn@gmail.com
SUPER_ADMIN_MODE=true
CLEARANCE_LEVEL=SUPER_ADMIN

# Database Configurations (PostgreSQL)
POSTGRES_DB=alolabs_command_center
POSTGRES_USER=alolabs_admin
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_HOST=alolabs-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alolabs_admin:CHANGE_THIS_STRONG_PASSWORD@alolabs-postgres:5432/alolabs_command_center

# Redis Cache/Queue Setup
REDIS_URL=redis://alolabs-redis:6379

# Object Storage (MinIO)
MINIO_ENDPOINT=http://alolabs-minio:9000
MINIO_ACCESS_KEY=USE_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=USE_STRONG_SECRET_KEY
MINIO_BUCKET=alolabs-storage

# Vector and Graph Databases
QDRANT_URL=http://alolabs-qdrant:6333
NEO4J_URL=bolt://alolabs-neo4j:7687

# Security Tokens and Encryption
JWT_SECRET=CHANGE_THIS_64_CHARACTER_RANDOM_SECRET
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=CHANGE_THIS_32_CHARACTER_RANDOM_KEY
COOKIE_SECRET=CHANGE_THIS_64_CHARACTER_RANDOM_SECRET

# Controls & Isolation
MULTI_COMPANY_MODE=true
TENANT_ISOLATION=true
APPROVAL_REQUIRED=true
PUBLIC_STUDIO_ENABLED=false
ALLOW_PUBLIC_API_KEYS=false
ALLOW_PUBLIC_MEMORY_ACCESS=false

# Brand Guidelines
BRAND_PRIMARY_BLUE=#0057B8
BRAND_PRIMARY_ORANGE=#E8501A
BRAND_WHITE=#FFFFFF
ALLOW_DARK_MODE=false
