# ============================================================
# ALO Labs AgentOS / AI-EOS — Production Environment Variables
# Canonical public domain: https://www.alolabs.net
# Port: 3011 (loopback only — Caddy terminates TLS and proxies to it)
# ============================================================

# ── Application ────────────────────────────────────────────────
NODE_ENV=production
PORT=3011
APP_PORT=3011
# Bind the Next.js standalone server to loopback so 3011 is never reachable
# from the network. Only Caddy should proxy to it.
HOSTNAME=127.0.0.1

# Canonical public origin. Used for OAuth redirect URIs, the sitemap, media
# URLs handed to AI providers, and CSRF trusted origins. Must be the `www`
# host — see deploy/caddy/alolabs.net.Caddyfile.
NEXT_PUBLIC_APP_URL=https://www.alolabs.net
# Legacy internal-routing variable. src/lib/internal-url.ts honours it only
# when it points at loopback; for a public origin it is ignored in favour of
# INTERNAL_APP_URL / http://127.0.0.1:3011. Kept aligned with the canonical
# domain so `publicBaseUrl()` has a correct fallback.
NEXT_PUBLIC_BASE_URL=https://www.alolabs.net

# CORS / trusted origins. The apex is listed as well so an operator who has not
# yet enabled the apex->www redirect does not get CORS failures; the existing
# panel/api subdomains are preserved because other services still use them.
# No wildcard and no http:// origin is permitted in production.
ALLOWED_ORIGINS=https://www.alolabs.net,https://alolabs.net,https://panel.alolabs.net,https://api.alolabs.net
SITE_NAME="ALO Labs AgentOS"
SITE_URL=https://www.alolabs.net

# ── Security & Authentication ──────────────────────────────────
# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-secure-random-64-character-app-secret
JWT_SECRET=replace-with-a-secure-random-64-character-jwt-secret
SESSION_SECRET=replace-with-a-secure-random-64-character-session-secret
ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-hex-encryption-key
CSRF_SECRET=replace-with-a-secure-random-64-character-csrf-secret

# ── Database (MANDATORY: MySQL / MariaDB) ──────────────────────
# MySQL/MariaDB is the only supported production datasource. SQLite is not
# acceptable in production, not a fallback, and not an alternative mode:
# src/lib/production-database.ts makes the server refuse to start on anything
# else, and deploy/scripts/deploy.sh aborts the deployment.
#
# Format: mysql://[user]:[password]@[host]:[port]/[database]?connection_limit=N
#   connection_limit sizes the Prisma pool. Keep it below MariaDB's
#   max_connections minus headroom for admin sessions and the backup job.
DATABASE_URL=mysql://agentos_app:replace_with_db_password@127.0.0.1:3306/alolabs_prod?connection_limit=10

# Create the database and a restricted account (run as a MySQL admin):
#   CREATE DATABASE alolabs_prod CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'agentos_app'@'localhost' IDENTIFIED BY '<strong-password>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP,
#         REFERENCES, CREATE TEMPORARY TABLES, LOCK TABLES, EXECUTE,
#         CREATE VIEW, SHOW VIEW, CREATE ROUTINE, ALTER ROUTINE, TRIGGER
#     ON alolabs_prod.* TO 'agentos_app'@'localhost';
#   FLUSH PRIVILEGES;
# Deliberately NOT granted: GRANT OPTION, SUPER, FILE, PROCESS, SHUTDOWN,
# RELOAD — the application does not need them, and FILE would allow reading
# server-side files through SQL.
#
# The Prisma client MUST be generated from the MySQL schema:
#   npm run db:generate:mysql      # prisma generate --schema=prisma/schema.mysql.prisma
# `npm run db:generate` (the SQLite schema) must never be what production runs.

# ── Redis (Distributed Queue & Cache) ──────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=alolabs:prod:

# ── Storage & MinIO S3 ─────────────────────────────────────────
STORAGE_PROVIDER=s3
STORAGE_PATH=./storage
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=replace_minio_access_key
MINIO_SECRET_KEY=replace_minio_secret_key
MINIO_BUCKET=agent-hub
MINIO_REGION=us-east-1
MINIO_SSL=false

# ── Backup Storage ─────────────────────────────────────────────
S3_BACKUP_BUCKET=aios-backups
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace_s3_access_key
S3_SECRET_KEY=replace_s3_secret_key

# ── Vector Search / Qdrant RAG ─────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── AI Providers (Configured via Enterprise Model Hub) ─────────
# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# OpenAI / Anthropic / Mistral / Qwen
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AI_CHAT=30
