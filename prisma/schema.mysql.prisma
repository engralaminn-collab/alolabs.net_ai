  @@unique([templateId, companyId])
  @@index([companyId, installedAt])
  @@index([templateId, status])
}

model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  version    String
  configJson String   @db.LongText
  changeLog  String   @db.LongText
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())

  template MarketplaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, isCurrent])
}

model CrossSystemSyncLog {
  id           String    @id @default(cuid())
  sourceSystem String
  targetSystem String
  syncType     String
  entityType   String
  entityId     String?
  payload      String    @default("{}") @db.LongText
  status       String    @default("pending")
  durationMs   Int?
  completedAt  DateTime?
  errorMessage String?   @db.LongText
  retryCount   Int       @default(0)
  syncedBy     String?   @db.LongText
  companyId    String?
  instanceId   String?
  createdAt    DateTime  @default(now())

  company  Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance AgentInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([status, createdAt])
  @@index([sourceSystem, targetSystem])
  @@index([entityType, entityId])
}

model TrainingSource {
  id            String    @id @default(cuid())
  name          String
  type          String
  sourceUrl     String?   @db.LongText
  filePath      String?   @db.LongText
  fileSize      Int       @default(0)
  content       String?   @db.LongText
  level         Int       @default(1)
  ragDocumentId String?   @unique
  companyId     String?
  departmentId  String?
  agentId       String?
  status        String    @default("pending")
  error         String?   @db.LongText
  chunkCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  parsedAt      DateTime?
  embeddedAt    DateTime?

  company     Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department  Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  agent       Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  ragDocument RagDocument?      @relation(fields: [ragDocumentId], references: [id], onDelete: SetNull)
  evaluations AgentEvaluation[]

  @@index([companyId, createdAt])
  @@index([departmentId])
  @@index([agentId, status])
  @@index([status, createdAt])
}

model AgentExecution {
  id              String    @id @default(cuid())
  instanceId      String
  assignedAgentId String?
  agentRunId      String?   @unique
  requestId       String    @unique
  companyId       String?
  userId          String?
  priority        String    @default("normal")
  input           String    @db.LongText
  validatedInput  String?   @db.LongText
  securityFlags   String?   @db.LongText
  riskScore       Float?
  approvalId      String?
  step            String    @default("request")
  stepNumber      Int       @default(1)
  status          String    @default("pending")
  executionPlan   String?   @db.LongText
  selectedTools   String?   @db.LongText
  executionOutput String?   @db.LongText
  reviewResult    String?   @db.LongText
  logIds          String?   @db.LongText
  deliveryResult  String?   @db.LongText
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  error           String?   @db.LongText
  errorMessage    String?   @db.LongText
  durationMs      Int?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  instance       AgentInstance        @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  agent          Agent?               @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  company        Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approval       Approval?            @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  agentRun       AgentRun?            @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  messages       AgentMessage[]
  recoveryEvents AgentRecoveryEvent[]

  @@index([instanceId, createdAt])
  @@index([assignedAgentId, createdAt])
  @@index([companyId, status])
  @@index([status, updatedAt])
}

model AgentMessage {
  id          String   @id @default(cuid())
  executionId String
  role        String
  content     String   @db.LongText
  toolCalls   String   @default("[]") @db.LongText
  createdAt   DateTime @default(now())

  execution AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}
