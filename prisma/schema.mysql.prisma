  sopId         String   @unique
  title         String
  category      String // onboarding, operations, security, incident, deployment, compliance, communication, quality
  departmentId  String?
  ownerRole     String   @default("manager") @db.LongText
  priority      String   @default("medium")
  description   String   @db.LongText
  steps         String   @default("[]") @db.LongText // JSON array of step objects
  checklist     String   @default("[]") @db.LongText // JSON array of checklist items
  estimatedTime String   @default("30 min") @db.LongText
  version       Int      @default(1)
  status        String   @default("active") // draft, active, deprecated
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([category])
  @@index([departmentId])
  @@index([status])
}

model PromptTemplate {
