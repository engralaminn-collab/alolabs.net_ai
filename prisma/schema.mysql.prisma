  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([category])
  @@index([departmentId])
  @@index([agentTypeId])
}

model KnowledgeNode {
  id           String   @id @default(cuid())
  nodeId       String   @unique
  title        String
  type         String // concept, entity, process, rule, skill, tool, document, person, department
  domain       String   @default("enterprise")
  departmentId String?
  content      String   @default("") @db.LongText
  metadata     String   @default("{}") @db.LongText // JSON
  confidence   Float    @default(1.0)
  source       String   @default("internal")
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department    Department?     @relation(fields: [departmentId], references: [id])
  outgoingEdges KnowledgeEdge[] @relation("EdgeFrom")
  incomingEdges KnowledgeEdge[] @relation("EdgeTo")

  @@index([type])
  @@index([domain])
  @@index([departmentId])
}

model KnowledgeEdge {
  id           String   @id @default(cuid())
  edgeId       String   @unique
  fromNodeId   String
  toNodeId     String
  relationType String // depends_on, part_of, related_to, implements, requires, produces, governs
  weight       Float    @default(1.0)
  metadata     String   @default("{}") @db.LongText
  createdAt    DateTime @default(now())

  fromNode KnowledgeNode @relation("EdgeFrom", fields: [fromNodeId], references: [id])
  toNode   KnowledgeNode @relation("EdgeTo", fields: [toNodeId], references: [id])

  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([relationType])
}

model CollaborationSession {
