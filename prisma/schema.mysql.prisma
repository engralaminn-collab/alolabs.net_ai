  templateId   String   @unique
  title        String
  category     String // analysis, generation, coding, writing, research, planning, review, optimization, communication, creative
  subcategory  String   @default("")
  departmentId String?
  agentTypeId  String   @default("") // links to agent type
  description  String   @default("") @db.LongText
  systemPrompt String   @db.LongText
  userTemplate String   @default("") @db.LongText
  variables    String   @default("[]") @db.LongText // JSON array of variable definitions
  outputFormat String   @default("text") @db.LongText // text, json, markdown, code, structured
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(2048)
  version      Int      @default(1)
  isPublic     Boolean  @default(true)
