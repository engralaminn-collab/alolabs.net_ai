  departmentId String?
  duration     Int      @default(0) // ms
  score        Float?
  metadata     String   @default("{}") @db.LongText
  createdAt    DateTime @default(now())

  @@index([engineType])
  @@index([status])
  @@index([agentId])
  @@index([createdAt])
}

model EnterpriseEvent {
  id            String   @id @default(cuid())
  eventType     String // agent.action, system.health, workflow.complete, rule.violated, compliance.breach, etc
  source        String   @default("system")
  severity      String   @default("info") // critical, warning, info, debug
  payload       String   @default("{}") @db.LongText // JSON
  agentId       String?
  departmentId  String?
  correlationId String?
