generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("viewer") // super_admin, admin, manager, operator, viewer
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  otpSecret    String?
  otpEnabled   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs             AuditLog[]
  approvals             Approval[]
  oauthAccounts         OAuthAccount[]
  commands              Command[]
  managedDepartments    Department[]
  collaborationSessions CollaborationSession[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions         RolePermission[]
  skillPermissions    SkillPermission[]
  workflowPermissions WorkflowPermission[]
}

model Permission {
  id        String   @id @default(cuid())
  name      String   @unique
  resource  String
  action    String
  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.LongText
  managerId   String?
  agentCount  Int      @default(20)
  sortOrder   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager             User?                @relation(fields: [managerId], references: [id])
  agents              Agent[]
  departmentMemories  DepartmentMemory[]
  constitutionalRules ConstitutionalRule[]
  enterpriseSOPs      EnterpriseSOP[]
  promptTemplates     PromptTemplate[]
  knowledgeNodes      KnowledgeNode[]
  trainingSources     TrainingSource[]
}

model Agent {
  id                String   @id @default(cuid())
  agentId           String   @unique // AGENT-0001 format
  name              String
  slug              String   @unique
  departmentId      String
  departmentName    String
  purpose           String   @db.LongText
  type              String   @default("specialist") // conversational, autonomous, workflow, specialized
  role              String   @default("specialist") // manager, planner, execution, qa, report, automation, safety, memory, productivity, owner_approval, specialist
  allowedSkills     String   @default("[]") @db.LongText
  forbiddenSkills   String   @default("[]") @db.LongText
  allowedTools      String   @default("[]") @db.LongText
  forbiddenTools    String   @default("[]") @db.LongText
  inputSchema       String   @default("{}") @db.LongText
  outputSchema      String   @default("{}") @db.LongText
  workflowSteps     String   @default("[]") @db.LongText
  protectionRules   String   @default("[]") @db.LongText
  approvalRules     String   @default("[]") @db.LongText
  handoffRules      String   @default("[]") @db.LongText
  qualityChecklist  String   @default("[]") @db.LongText
  selfImprovement   String   @default("{}") @db.LongText
  productivityRules String   @default("{}") @db.LongText
  status            String   @default("active")
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  department             Department             @relation(fields: [departmentId], references: [id])
  versions               AgentVersion[]
  permissions            AgentPermission[]
  tasks                  Task[]
  memory                 AgentMemory[]
  agentCompanyAccess     AgentCompanyAccess[]
  healthRecords          AgentHealth[]
  statusHistory          AgentStatusHistory[]
  trainingRecords        AgentTrainingRecord[]
  agentRuns              AgentRun[]
  tokenUsage             TokenUsage[]
  evolution              AgentEvolution?
  learningSessions       AgentLearningSession[]
  protectiveMode         AgentProtectiveMode?
  instances              AgentInstance[]
  alerts                 AgentAlert[]
  communicationsSent     AgentCommunication[]   @relation("CommunicationFromAgent")
  communicationsReceived AgentCommunication[]   @relation("CommunicationToAgent")
  trainingSources        TrainingSource[]
  metrics                Metric[]
  recoveryEvents         AgentRecoveryEvent[]
  executions             AgentExecution[]
  evaluations            AgentEvaluation[]

  @@index([departmentId])
}

model AgentVersion {
  id        String   @id @default(cuid())
  agentId   String
  version   Int
  config    String   @db.LongText // JSON snapshot
  changeLog String?  @db.LongText
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
}

model AgentPermission {
  id          String   @id @default(cuid())
  agentId     String
  resourceId  String
  accessLevel String   @default("read") // read, write, execute, admin
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Skill {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  category            String
  categorySlug        String
  title               String
  version             String   @default("1.0.0")
  status              String   @default("private") // private, approved, quarantined, disabled
  riskLevel           String   @default("low") @db.LongText // low, medium, high
  requiresApproval    Boolean  @default(true)
  description         String   @default("") @db.LongText
  runtime             String   @default("builtin") // node, python, builtin
  allowedTools        String   @default("[]") @db.LongText
  forbiddenTools      String   @default("[]") @db.LongText
  inputs              String   @default("[]") @db.LongText
  outputs             String   @default("[]") @db.LongText
  purpose             String   @default("") @db.LongText
  validationRules     String   @default("{}") @db.LongText
  securityRules       String   @default("{}") @db.LongText
  costPolicy          String   @default("{}") @db.LongText
  requiredPermissions String   @default("[]") @db.LongText
  safetyRules         String   @default("[]") @db.LongText
  approvalRules       String   @default("") @db.LongText
  failureHandling     String   @default("") @db.LongText
  content             String   @default("") @db.LongText // SKILL.md body
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  versions           SkillVersion[]
  permissions        SkillPermission[]
  validationLogs     SkillValidationLog[]
  skillCompanyAccess SkillCompanyAccess[]
  skillRuns          SkillRun[]
}

model SkillVersion {
  id        String   @id @default(cuid())
  skillId   String
  version   String
  content   String   @db.LongText
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
}

model SkillPermission {
  id          String   @id @default(cuid())
  skillId     String
  roleId      String?
  accessLevel String   @default("use")
  createdAt   DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  role  Role? @relation(fields: [roleId], references: [id])

  @@index([skillId])
}

model SkillValidationLog {
  id        String   @id @default(cuid())
  skillId   String
  status    String // PASS, WARNING, BLOCKED
  reason    String?  @db.LongText
  checkedBy String?  @db.LongText
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Command {
  id           String    @id @default(cuid())
  rawCommand   String    @db.LongText
  parsedIntent String?   @db.LongText
  detectedDept String?   @db.LongText
  workflowId   String?
  status       String    @default("pending") // pending, processing, completed, failed, blocked
  result       String?   @db.LongText
  userId       String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  workflow Workflow? @relation(fields: [workflowId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model Task {
  id           String    @id @default(cuid())
  commandId    String?
  title        String
  description  String?   @db.LongText
  status       String    @default("pending") // pending, in_progress, completed, failed, blocked
  priority     String    @default("medium")
  departmentId String?
  agentId      String?
  workflowId   String?
  userId       String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent      Agent?      @relation(fields: [agentId], references: [id])
  workflow   Workflow?   @relation(fields: [workflowId], references: [id])
  steps      TaskStep[]
  outputs    Output[]
  taskErrors TaskError[]
  agentRuns  AgentRun[]
  skillRuns  SkillRun[]

  @@index([agentId])
  @@index([workflowId])
}

model TaskStep {
  id          String    @id @default(cuid())
  taskId      String
  stepNumber  Int
  agentId     String?
  skillId     String?
  action      String
  input       String    @default("{}") @db.LongText
  output      String?   @db.LongText
  status      String    @default("pending") // pending, in_progress, completed, failed
  error       String?   @db.LongText
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Workflow {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?  @db.LongText
  triggers     String   @default("[]") @db.LongText
  stepConfigs  String   @default("[]") @db.LongText
  departmentId String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workflowSteps       WorkflowStep[]
  workflowPermissions WorkflowPermission[]
  commands            Command[]
  runs                WorkflowRun[]
  tasks               Task[]
  improvementRequests WorkflowImprovementRequest[]
}

model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  stepNumber Int
  agentId    String?
  skillId    String?
  action     String
  config     String   @default("{}") @db.LongText
  createdAt  DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model Approval {
  id           String    @id @default(cuid())
  type         String // agent_build, skill_build, workflow_build, tool_approval, paid_api, external_cost, deployment, dns_change, file_delete, public_publish, bulk_whatsapp, real_human_face, voice_clone, legal_final, financial_final, shell_command, new_agent, new_skill, new_workflow
  title        String
  description  String?   @db.LongText
  requestJson  String    @default("{}") @db.LongText
  status       String    @default("pending") // pending, approved, rejected, expired
  requestedBy  String?
  reviewedBy   String?   @db.LongText
  reviewedAt   DateTime?
  responseNote String?   @db.LongText
  riskLevel    String    @default("medium") @db.LongText
  executionId  String?
  companyId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user            User?            @relation(fields: [requestedBy], references: [id])
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRuns       AgentRun[]
  agentExecutions AgentExecution[]

  @@index([companyId, status])
  @@index([executionId])
}

model CapabilityRequest {
  id          String   @id @default(cuid())
  type        String // new_agent, new_skill, new_workflow
  title       String
  description String?  @db.LongText
  proposedBy  String?  @db.LongText
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentBuildRequest {
  id           String   @id @default(cuid())
  agentName    String   @db.LongText
  departmentId String?
  config       String   @default("{}") @db.LongText
  status       String   @default("pending")
  result       String?  @db.LongText
  createdAt    DateTime @default(now())
}

model SkillBuildRequest {
  id        String   @id @default(cuid())
  skillName String   @db.LongText
  category  String?
  content   String   @default("") @db.LongText
  status    String   @default("pending")
  result    String?  @db.LongText
  createdAt DateTime @default(now())
}

model WorkflowBuildRequest {
  id           String   @id @default(cuid())
  workflowName String   @db.LongText
  config       String   @default("{}") @db.LongText
  status       String   @default("pending")
  result       String?  @db.LongText
  createdAt    DateTime @default(now())
}

model ToolApprovalRequest {
  id        String   @id @default(cuid())
  toolName  String   @db.LongText
  reason    String?  @db.LongText
  riskLevel String   @default("medium") @db.LongText
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model DomainDeployment {
  id          String   @id @default(cuid())
  domain      String
  projectType String?  @db.LongText
  status      String   @default("pending") // pending, deploying, success, failed
  deployLog   String   @default("[]") @db.LongText
  sslStatus   String   @default("none") @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectUpload {
  id         String   @id @default(cuid())
  fileName   String   @db.LongText
  fileSize   Int      @default(0)
  fileType   String?  @db.LongText
  storedPath String?  @db.LongText
  uploadedBy String?  @db.LongText
  status     String   @default("stored")
  createdAt  DateTime @default(now())
}

model AgentMemory {
  id           String    @id @default(cuid())
  agentId      String
  companyId    String?
  category     String    @default("general") // general, learning, correction, pattern
  content      String    @db.LongText
  temperature  String    @default("hot") @db.LongText // hot, warm, cold
  successCount Int       @default(0)
  failCount    Int       @default(0)
  useCount     Int       @default(0)
  confidence   Float     @default(0.5)
  source       String    @default("experience")
  tags         String    @default("[]") @db.LongText
  isVerified   Boolean   @default(false)
  promotedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agent   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([companyId, agentId, createdAt])
}

model DepartmentMemory {
  id           String   @id @default(cuid())
  departmentId String
  category     String   @default("general")
  content      String   @db.LongText
  temperature  String   @default("warm") @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

model CompanyMemory {
  id        String   @id @default(cuid())
  companyId String
  category  String   @default("general")
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model LearningReport {
  id          String   @id @default(cuid())
  taskId      String?
  agentId     String?
  whatWorked  String   @default("[]") @db.LongText
  whatFailed  String   @default("[]") @db.LongText
  corrections String   @default("[]") @db.LongText
  pattern     String?  @db.LongText
  suggestion  String?  @db.LongText
  createdAt   DateTime @default(now())
}

model ProductivityReport {
  id                     String   @id @default(cuid())
  taskId                 String?
  speedScore             Float    @default(0)
  qualityScore           Float    @default(0)
  reuseScore             Float    @default(0)
  errorScore             Float    @default(0)
  finalProductivityScore Float    @default(0)
  recommendations        String   @default("[]") @db.LongText
  createdAt              DateTime @default(now())
}

model BlockedAction {
  id         String   @id @default(cuid())
  actionType String   @db.LongText
  reason     String   @db.LongText
  commandId  String?
  agentId    String?
  createdAt  DateTime @default(now())
}

model PaymentGuardLog {
  id              String   @id @default(cuid())
  apiName         String
  blocked         Boolean  @default(true)
  replacementUsed Boolean  @default(false)
  replacementName String?  @db.LongText
  reason          String?  @db.LongText
  commandId       String?
  createdAt       DateTime @default(now())

  @@index([apiName])
  @@index([createdAt])
}

model ProtectionLog {
  id         String   @id @default(cuid())
  actionType String   @db.LongText
  blocked    Boolean  @default(true)
  reason     String   @db.LongText
  commandId  String?
  agentId    String?
  createdAt  DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String   @default("{}") @db.LongText
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Output {
  id        String   @id @default(cuid())
  taskId    String
  type      String   @default("text") // text, file, image, video, audio, report
  content   String   @db.LongText
  filePath  String?  @db.LongText
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.LongText
  type      String   @default("string") // string, number, boolean, json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthCheck {
  id         String   @id @default(cuid())
  service    String   @db.LongText
  status     String   @default("healthy") // healthy, degraded, down
  responseMs Int?
  details    String?  @db.LongText
  createdAt  DateTime @default(now())
}

model ErrorLog {
  id        String   @id @default(cuid())
  source    String
  message   String   @db.LongText
  stack     String?  @db.LongText
  severity  String   @default("error")
  createdAt DateTime @default(now())
}

model ServerLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  message   String   @db.LongText
  metadata  String   @default("{}") @db.LongText
  createdAt DateTime @default(now())
}

model DeploymentLog {
  id          String   @id @default(cuid())
  domain      String?
  projectType String?  @db.LongText
  action      String
  status      String   @default("success")
  details     String   @default("{}") @db.LongText
  createdAt   DateTime @default(now())
}

model SOPUpdate {
  id           String   @id @default(cuid())
  departmentId String?
  title        String
  content      String   @db.LongText
  reason       String?  @db.LongText
  status       String   @default("suggested") // suggested, approved, applied
  suggestedBy  String?  @db.LongText
  approvedBy   String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkflowImprovementRequest {
  id          String   @id @default(cuid())
  workflowId  String?
  title       String
  description String?  @db.LongText
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  workflow Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model AutomationSuggestion {
  id           String   @id @default(cuid())
  title        String
  description  String?  @db.LongText
  departmentId String?
  frequency    String?  @db.LongText
  status       String   @default("suggested") // suggested, approved, implemented, rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model File {
  id         String   @id @default(cuid())
  name       String
  path       String   @db.LongText
  size       Int      @default(0)
  mimeType   String?
  category   String?
  uploadedBy String?  @db.LongText
  createdAt  DateTime @default(now())
}

model Company {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  domain               String?
  status               String   @default("active")
  allowedWorkflows     String   @default("[]") @db.LongText
  allowedDepartments   String   @default("[]") @db.LongText
  monthlyUsageLimit    Int      @default(10000)
  paidApiAllowed       Boolean  @default(false)
  smsAllowed           Boolean  @default(false)
  whatsappBulkAllowed  Boolean  @default(false)
  publicPublishAllowed Boolean  @default(false)
  apiSecret            String?  @db.LongText
  webCrmConnected      Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users                 CompanyUser[]
  apiKeys               CompanyApiKey[]
  usageLogs             UsageLog[]
  permissions           CompanyPermission[]
  subscription          Subscription?
  invoices              Invoice[]
  payments              Payment[]
  tokenBudget           TokenBudget?
  tenantConfig          TenantConfig?
  companyDomains        CompanyDomain[]
  ipAllowlists          CompanyIpAllowlist[]
  agentAccess           AgentCompanyAccess[]
  skillAccess           SkillCompanyAccess[]
  webhooks              WebhookConfig[]
  workflowRuns          WorkflowRun[]
  companyMemories       CompanyMemory[]
  agentMemories         AgentMemory[]
  brand                 Brand?
  workflowPermissions   WorkflowPermission[]
  collaborationSessions CollaborationSession[]
  tokenUsages           TokenUsage[]
  agentInstances        AgentInstance[]
  agentAlerts           AgentAlert[]
  agentCommunications   AgentCommunication[]
  syncLogs              CrossSystemSyncLog[]
  trainingSources       TrainingSource[]
  metrics               Metric[]
  constitutionalRules   ConstitutionalRule[]
  templateInstalls      TemplateInstall[]
  approvals             Approval[]
  improvementProposals  AgentImprovementProposal[]
  recoveryEvents        AgentRecoveryEvent[]
  agentExecutions       AgentExecution[]
  agentLearningSessions AgentLearningSession[]
}

model CompanyUser {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  role      String   @default("operator")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

model CompanyApiKey {
  id              String    @id @default(cuid())
  companyId       String
  keyHash         String    @unique
  keyPrefix       String    @db.LongText
  keySuffix       String    @default("") @db.LongText
  name            String
  keyType         String    @default("live") @db.LongText // test, live, restricted, service, webhook
  scopes          String    @default("[]") @db.LongText // JSON array of scope strings
  rateLimit       Int       @default(1000) // requests per minute
  ipAllowlist     String    @default("[]") @db.LongText // JSON array of allowed IPs
  isActive        Boolean   @default(true)
  lastUsedAt      DateTime?
  rotatedAt       DateTime?
  previousKeyHash String?   @db.LongText
  expiresAt       DateTime?
  createdBy       String?   @db.LongText
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyPermission {
  id           String   @id @default(cuid())
  companyId    String
  departmentId String?
  agentId      String?
  accessLevel  String   @default("read")
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id                String    @id @default(cuid())
  companyId         String?
  companyName       String?   @db.LongText
  userId            String?
  userName          String?   @db.LongText
  commandId         String?
  taskId            String?
  workflowId        String?
  workflowName      String?   @db.LongText
  agentId           String?
  agentName         String?   @db.LongText
  skillId           String?
  skillName         String?   @db.LongText
  tokensOrLocalUsed Int       @default(0)
  paidApiUsed       Boolean   @default(false)
  externalCostRisk  String    @default("none") @db.LongText
  approvalRequired  Boolean   @default(false)
  status            String    @default("completed")
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflowId   String
  workflowName String?   @db.LongText
  companyId    String?
  status       String    @default("running")
