model ConstitutionalRule {
  id           String   @id @default(cuid())
  ruleId       String   @unique
  title        String
  category     String // governance, security, compliance, operations, ethics, data, ai, hr, finance, legal
  severity     String   @default("critical") // critical, high, medium, low, informational
  description  String   @db.LongText
  conditions   String   @default("[]") @db.LongText // JSON array of conditions
  actions      String   @default("[]") @db.LongText // JSON array of required actions
