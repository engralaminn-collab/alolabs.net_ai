  successCriteria      String @db.LongText   // JSON array
  capabilityGap        String @db.LongText
  reason               String @db.LongText
  generation           Int      @default(1)
  isLoopAgent          Boolean  @default(false)
  qualificationScore   Float    @default(0.0)
  qualificationDetails String @db.LongText   // JSON
  status               String   @default("proposed") // proposed, observing, evaluated, approved, rejected, created
  reviewNotes          String? @db.LongText
  reviewedBy           String? @db.LongText
  reviewedAt           DateTime?
  createdAgentId       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([parentAgentId])
  @@index([departmentId])
  @@index([status])
}

